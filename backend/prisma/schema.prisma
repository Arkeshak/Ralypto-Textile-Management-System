datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id              String             @id @default(uuid())
  name            String
  legalName       String?
  phone           String
  email           String?
  address         String?
  currency        String             @default("LKR")
  timezone        String             @default("Asia/Colombo")
  taxRate         Float              @default(0.0)
  logoUrl         String?
  receiptFooter   String?            @default("Thank you for shopping with Ralypto! Exchange within 7 days with receipt.")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  branches        Branch[]
  users           User[]
  roles           Role[]
  categories      Category[]
  brands          Brand[]
  suppliers       Supplier[]
  customers       Customer[]
  products        Product[]
  inventoryBalances InventoryBalance[]
  stockMovements  StockMovement[]
  sales           Sale[]
  returns         Return[]
  purchases       PurchaseOrder[]
  expenses        Expense[]
  auditLogs       AuditLog[]
  aiTryOnJobs     AITryOnJob[]
  aiPhotoStudioJobs AIPhotoStudioJob[]
  aiUsageQuota    AIUsageQuota?
}

model Branch {
  id              String             @id @default(uuid())
  businessId      String
  name            String
  code            String             // e.g. "COL-03", "KND-01"
  address         String?
  phone           String?
  isMain          Boolean            @default(false)
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  business        Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users           User[]
  inventoryBalances InventoryBalance[]
  stockMovements  StockMovement[]
  sales           Sale[]
  returns         Return[]
  purchases       PurchaseOrder[]
  expenses        Expense[]

  @@unique([businessId, code])
}

model Role {
  id          String    @id @default(uuid())
  businessId  String
  name        String    // e.g., "Owner", "Admin", "Manager", "Cashier", "Inventory Manager"
  description String?
  permissions String    // JSON array of permission strings e.g. ["sales:create", "products:manage"]
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([businessId, name])
}

model User {
  id           String     @id @default(uuid())
  businessId   String
  branchId     String?
  name         String
  email        String
  phone        String?
  passwordHash String
  roleId       String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch       Branch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sales        Sale[]
  expenses     Expense[]
  stockMovements StockMovement[]
  auditLogs    AuditLog[]

  @@unique([businessId, email])
}

model Category {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, slug])
}

model Brand {
  id          String    @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([businessId, slug])
}

model Product {
  id          String           @id @default(uuid())
  businessId  String
  name        String
  slug        String
  description String?
  categoryId  String
  brandId     String?
  supplierId  String?
  basePrice   Float            @default(0.0)
  baseCost    Float            @default(0.0)
  imageUrl    String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  business    Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brand       Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  supplier    Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  variants    ProductVariant[]
  aiTryOnJobs AITryOnJob[]
  aiPhotoStudioJobs AIPhotoStudioJob[]

  @@unique([businessId, slug])
}

model ProductVariant {
  id           String             @id @default(uuid())
  productId    String
  sku          String             // e.g. "DRS-BLK-S"
  barcode      String?            // Barcode scanned at POS
  size         String             // "S", "M", "L", "XL", "Free Size"
  color        String             // "Black", "Royal Blue", "Emerald Green", "Crimson Red"
  colorHex     String?            // "#1E293B"
  costPrice    Float              @default(0.0)
  sellingPrice Float              @default(0.0)
  reorderLevel Int                @default(5)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  movements    StockMovement[]
  saleItems    SaleItem[]
  returnItems  ReturnItem[]
  purchaseItems PurchaseOrderItem[]
  aiTryOnJobs   AITryOnJob[]

  @@unique([productId, sku])
}

model InventoryBalance {
  id                String         @id @default(uuid())
  businessId        String
  branchId          String
  variantId         String
  quantityOnHand    Int            @default(0)
  allocatedQuantity Int            @default(0)
  updatedAt         DateTime       @updatedAt

  business          Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, variantId])
}

model StockMovement {
  id               String         @id @default(uuid())
  businessId       String
  branchId         String
  variantId        String
  movementType     String         // "OPENING_BALANCE", "PURCHASE_RECEIPT", "SALE", "CUSTOMER_RETURN", "SUPPLIER_RETURN", "DAMAGE", "CORRECTION", "TRANSFER_IN", "TRANSFER_OUT"
  quantityChange   Int            // positive for additions, negative for deductions
  previousQuantity Int
  newQuantity      Int
  costPerUnit      Float          @default(0.0)
  referenceType    String?        // "SALE", "PURCHASE", "RETURN", "MANUAL"
  referenceId      String?        // e.g. saleId, purchaseOrderId, returnId
  notes            String?
  createdByUserId  String?
  createdAt        DateTime       @default(now())

  business         Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  createdByUser    User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
}

model Customer {
  id                 String     @id @default(uuid())
  businessId         String
  name               String
  phone              String
  email              String?
  address            String?
  creditLimit        Float      @default(0.0)
  outstandingBalance Float      @default(0.0)
  loyaltyPoints      Int        @default(0)
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  business           Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sales              Sale[]

  @@unique([businessId, phone])
}

model Supplier {
  id                 String          @id @default(uuid())
  businessId         String
  name               String
  contactPerson      String?
  phone              String
  email              String?
  address            String?
  outstandingBalance Float           @default(0.0)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  business           Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products           Product[]
  purchases          PurchaseOrder[]
}

model Sale {
  id             String      @id @default(uuid())
  businessId     String
  branchId       String
  invoiceNumber  String      // e.g. "INV-COL03-20261024-0001"
  customerId     String?
  cashierUserId  String
  subtotal       Float       @default(0.0)
  discountAmount Float       @default(0.0)
  taxAmount      Float       @default(0.0)
  grandTotal     Float       @default(0.0)
  paidAmount     Float       @default(0.0)
  balanceDue     Float       @default(0.0)
  paymentStatus  String      @default("PAID") // "PAID", "PARTIAL", "UNPAID", "REFUNDED"
  paymentMethod  String      @default("CASH") // "CASH", "CARD", "BANK_TRANSFER", "CREDIT", "SPLIT"
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  business       Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashier        User        @relation(fields: [cashierUserId], references: [id], onDelete: Restrict)
  items          SaleItem[]
  payments       Payment[]
  returns        Return[]

  @@unique([businessId, invoiceNumber])
}

model SaleItem {
  id             String         @id @default(uuid())
  saleId         String
  variantId      String
  productName    String
  variantDetails String         // "Size: M, Color: Royal Blue"
  quantity       Int
  unitCost       Float          @default(0.0)
  unitPrice      Float
  discountAmount Float          @default(0.0)
  totalPrice     Float

  sale           Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  returnItems    ReturnItem[]
}

model Payment {
  id            String   @id @default(uuid())
  saleId        String
  businessId    String
  paymentMethod String   // "CASH", "CARD", "BANK_TRANSFER", "CREDIT"
  amount        Float
  referenceNote String?  // e.g., Card approval code, bank transaction ref
  createdAt     DateTime @default(now())

  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Return {
  id                String       @id @default(uuid())
  businessId        String
  branchId          String
  saleId            String
  returnNumber      String       // e.g. "RET-COL03-20261024-0001"
  totalRefundAmount Float        @default(0.0)
  reason            String       // "Defective / Stitching flaw", "Wrong size", "Customer preference"
  disposition       String       @default("RESTOCK") // "RESTOCK", "DAMAGED", "INSPECTION"
  notes             String?
  processedByUserId String?
  createdAt         DateTime     @default(now())

  business          Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch            Branch       @relation(fields: [branchId], references: [id], onDelete: Restrict)
  sale              Sale         @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items             ReturnItem[]

  @@unique([businessId, returnNumber])
}

model ReturnItem {
  id           String         @id @default(uuid())
  returnId     String
  saleItemId   String
  variantId    String
  quantity     Int
  unitPrice    Float
  refundAmount Float

  return       Return         @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem     SaleItem       @relation(fields: [saleItemId], references: [id], onDelete: Restrict)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  businessId  String
  branchId    String
  supplierId  String
  orderNumber String              // e.g. "PO-20261024-0001"
  status      String              @default("RECEIVED") // "PENDING", "RECEIVED", "CANCELLED"
  totalAmount Float               @default(0.0)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch      Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items       PurchaseOrderItem[]

  @@unique([businessId, orderNumber])
}

model PurchaseOrderItem {
  id               String         @id @default(uuid())
  purchaseOrderId  String
  variantId        String
  quantityOrdered  Int
  quantityReceived Int
  unitCost         Float
  totalCost        Float

  purchaseOrder    PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
}

model Expense {
  id               String   @id @default(uuid())
  businessId       String
  branchId         String
  category         String   // "Rent", "Electricity", "Salaries", "Packaging", "Marketing", "Repairs", "Miscellaneous"
  description      String
  amount           Float
  paymentMethod    String   @default("CASH") // "CASH", "BANK_TRANSFER", "CARD"
  expenseDate      DateTime @default(now())
  recordedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  business         Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Restrict)
  recordedByUser   User     @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String
  userId     String?
  action     String   // e.g., "PRICE_CHANGE", "DISCOUNT_APPROVED", "STOCK_ADJUSTMENT", "RETURN_PROCESSED"
  entityType String   // "PRODUCT", "SALE", "STOCK", "USER"
  entityId   String?
  details    String?  // JSON formatted details
  ipAddress  String?
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model AITryOnJob {
  id              String          @id @default(uuid())
  businessId      String
  sessionId       String?         // Anonymous customer browser session
  userId          String?         // Optional customer / staff account
  productId       String
  variantId       String?
  category        String          @default("dresses") // "dresses", "tops", "bottoms", "one-pieces"
  personImageUrl  String          // Private uploaded photo path / data URL
  garmentImageUrl String          // Authoritative product catalog image
  resultImageUrl  String?         // Resulting try-on image
  status          String          @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED", "DELETED"
  provider        String          @default("fashn-ai") // "fashn-ai", "dev-mode"
  providerJobId   String?
  cost            Float           @default(0.0)
  errorMessage    String?
  consentConfirmed Boolean        @default(true)
  isDeleted       Boolean         @default(false)
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
}

model AIUsageQuota {
  id                      String   @id @default(uuid())
  businessId              String   @unique
  dailyTryOnLimit         Int      @default(50)
  sessionTryOnLimit       Int      @default(5)
  currentMonthGenerations Int      @default(0)
  monthlySpendingLimitLkr Float    @default(50000.0)
  updatedAt               DateTime @updatedAt

  business                Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model AIPhotoStudioJob {
  id                  String    @id @default(uuid())
  businessId          String
  productId           String?
  originalImageUrl    String
  processedImageUrl   String?
  backgroundScene     String    // e.g. "LUXURY_STUDIO", "COLOMBO_BOUTIQUE", "TROPICAL_CEYLON", "MINIMALIST_SLATE"
  generatedTitle      String?
  generatedDescription String?
  generatedTags       String?   // JSON string of tags
  status              String    @default("COMPLETED") // "PENDING", "COMPLETED", "FAILED"
  approved            Boolean   @default(false)
  createdAt           DateTime  @default(now())

  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  product             Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
}

