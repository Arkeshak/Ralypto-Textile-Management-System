# Ralypto Dress Shop Management System Environment Configuration

PORT=5000
NODE_ENV=development

# Database configuration
# In local development, SQLite (file:./dev.db) is used by default for zero-setup ease.
# For production PostgreSQL: postgresql://postgres:postgres@localhost:5432/ralypto_dress_shop?schema=public
DATABASE_URL="file:./dev.db"

# Security & Tokens
JWT_SECRET=ralypto_super_secure_jwt_secret_lkr_retail_2026
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=ralypto_super_secure_refresh_token_secret_2026
REFRESH_TOKEN_EXPIRES_IN=7d

# Default Localization
DEFAULT_CURRENCY=LKR
DEFAULT_TIMEZONE=Asia/Colombo
DEFAULT_DATE_FORMAT=DD/MM/YYYY

# CORS
CORS_ORIGIN=http://localhost:5173
